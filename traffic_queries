/* Find all violations with fine amounts over $100 */
SELECT v.violation_id, v.violation_date, f.fine_amount
FROM violations v
JOIN fines f ON v.fine_id = f.fine_id
WHERE f.fine_amount > 100;


/* List all violations issued by officers with vehicle information */
SELECT v.violation_id, v.violation_date, vi.vehicle_make, 
       vi.license_plate_type, i.officer_id
FROM violations v
JOIN vehicle_information vi ON v.vehicle_id = vi.vehicle_id
JOIN issuing_information i ON v.issuing_information_id = i.issuing_information_id
WHERE v.issued_by = 'officer';


/* Count violations by location */
SELECT l.violation_location, COUNT(*) as violation_count
FROM violations v
JOIN locations l ON v.location_id = l.location_id
GROUP BY l.violation_location
ORDER BY violation_count DESC;


