/* Find all violations with fine amounts over $100 */
SELECT t.ticket_number, f.fine_amount
FROM Ticket t
JOIN Ticket_Fine tf
	ON t.ticket_number = tf.ticket_number
JOIN Fine f
	ON tf.fine_id = f.fine_id
WHERE f.fine_amount > 100;


/* List all violations issued by officers with vehicle information */
SELECT t.ticket_number,
		v.vehicle_make,
        v.license_plate_type,
        i.officer_id
FROM Ticket t
JOIN Vehicle v
	ON t.vehicle_id = v.vehicle_id
JOIN issuing i
	ON t.issuing_id = i.issuing_id
WHERE i.issued_by = 'officer';


/* Count violations by location */
SELECT l.violation_location, COUNT(*) as violation_count
FROM Ticket t
JOIN Location l
	ON t.location_id = l.location_id
GROUP BY l.violation_location
ORDER BY violation_count DESC;


